---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dashboardUrl } from '../lib/appLinks';

const registerUrl = dashboardUrl('/register');
---

<BaseLayout
  title="CrawlGap — Sitemap Based Competitor Research"
  description="Compare your site with competitor sites, review keyword opportunities from sitemap URLs, and use CrawlGap's research and content planning tools."
>
  <Header />
  <main>
    <!-- ══════════════════════════════════════
         HERO SECTION
    ══════════════════════════════════════ -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-bg" aria-hidden="true">
        <div class="glow-orb glow-amber" style="width:600px;height:600px;top:-200px;left:-100px;"></div>
        <div class="glow-orb glow-violet" style="width:500px;height:500px;top:100px;right:-150px;"></div>
        <div class="bg-grid" style="position:absolute;inset:0;opacity:0.6;"></div>
      </div>

      <div class="container hero-inner">
        <div class="hero-content">
          <div class="badge badge-amber animate-fade-up" style="margin-bottom:1.5rem;">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><circle cx="6" cy="6" r="6" opacity="0.3"/><circle cx="6" cy="6" r="3"/></svg>
            Sitemap based SEO research
          </div>

          <h1 id="hero-heading" class="hero-title animate-fade-up delay-100">
            Find content topics<br/>
            <span class="gradient-text">your site may be missing</span>
          </h1>

          <p class="hero-subtitle animate-fade-up delay-200">
            CrawlGap compares your site's sitemap with competitor sitemaps and shows
            keyword opportunities based on their URLs. Review the results, save keywords,
            and use the planning and writing tools to develop content ideas.
          </p>

          <div class="hero-cta animate-fade-up delay-300">
            <a href={registerUrl} class="btn btn-primary btn-lg" id="hero-cta-primary">
              Open CrawlGap
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M3.75 9h10.5M9 3.75 14.25 9 9 14.25" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="#how-it-works" class="btn btn-ghost btn-lg" id="hero-cta-demo">
              See How It Works
            </a>
          </div>

        </div>

        <!-- Dashboard Mockup -->
        <div class="hero-visual animate-fade-up delay-200">
          <div class="dashboard-frame">
            <div class="dashboard-chrome" aria-hidden="true">
              <span class="chrome-dot" style="background:#ff5f57;"></span>
              <span class="chrome-dot" style="background:#febc2e;"></span>
              <span class="chrome-dot" style="background:#28c840;"></span>
              <span class="chrome-url">app.crawlgap.io/projects</span>
            </div>
            <img
              src="/dashboard-mockup.png"
              alt="CrawlGap dashboard showing keyword opportunities table with competitor SEO analysis"
              width="680"
              height="420"
              loading="eager"
              fetchpriority="high"
              class="dashboard-img"
            />
          </div>
          <!-- Floating keyword pills -->
          <div class="floating-pill pill-1 animate-float" aria-hidden="true">content gap analysis</div>
          <div class="floating-pill pill-2 animate-float delay-200" aria-hidden="true">LSI keywords</div>
          <div class="floating-pill pill-3 animate-float delay-400" aria-hidden="true">competitor SEO</div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="scroll-indicator" aria-hidden="true">
        <div class="scroll-dot"></div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         FEATURES SECTION
    ══════════════════════════════════════ -->
    <section id="features" class="section" aria-labelledby="features-heading">
      <div class="container">
        <div class="section-header reveal">
          <p class="section-label">Platform Features</p>
          <h2 id="features-heading" class="section-title">
            Research and planning<br/><span class="gradient-text">for content opportunities</span>
          </h2>
          <p class="section-desc">
            CrawlGap includes sitemap comparison, keyword research, content planning, and AI assisted drafting tools.
          </p>
        </div>

        <div class="features-grid">
          {[
            {
              icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="1.5"/><path d="M15 12H9m3-3v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
              color: 'amber',
              title: 'Sitemap Comparison',
              desc: 'Compare pages listed on your site and competitor sitemaps to spot topics competitors cover that may be missing from your site.',
            },
            {
              icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
              color: 'violet',
              title: 'Keyword Research',
              desc: 'Review keyword ideas collected from sitemap URLs, competitor pages, seed topics, and AI assisted research.',
            },
            {
              icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/><path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
              color: 'green',
              title: 'Project Keyword Workspace',
              desc: 'Search, filter, sort, save, and export keyword opportunities associated with a project.',
            },
            {
              icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 19v-6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2zm0 0V9a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v10m-6 0a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2m0 0V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
              color: 'amber',
              title: 'Topic Planning',
              desc: 'Generate and review hub and spoke topic plans using project keywords and site context.',
            },
            {
              icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-7-7z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M13 2v7h7" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>`,
              color: 'amber',
              title: 'Page Prompts',
              desc: 'Analyze search intent and competitor pages, then generate a prompt for a page brief or AI site builder.',
            },
            {
              icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
              color: 'violet',
              title: 'Article Drafts',
              desc: 'Generate an AI assisted article draft from a selected keyword or a keyword cluster.',
            },
          ].map((feat, i) => (
            <div class={`glass-card feature-card reveal`} style={`animation-delay:${i * 0.1}s`}>
              <div class={`feature-icon feature-icon-${feat.color}`}>
                <Fragment set:html={feat.icon} />
              </div>
              <h3 class="feature-title">{feat.title}</h3>
              <p class="feature-desc">{feat.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         HOW IT WORKS
    ══════════════════════════════════════ -->
    <section id="how-it-works" class="section how-section" aria-labelledby="how-heading">
      <div class="how-bg" aria-hidden="true">
        <div class="glow-orb glow-violet" style="width:400px;height:400px;top:50%;left:50%;transform:translate(-50%,-50%);"></div>
      </div>
      <div class="container">
        <div class="section-header reveal">
          <p class="section-label">How It Works</p>
          <h2 id="how-heading" class="section-title">
            From project setup to<br/><span class="gradient-text">keyword opportunities</span>
          </h2>
        </div>

        <div class="steps-grid">
          {[
            { n: '01', color: '#F5A524', title: 'Create a project', desc: 'Enter your website and one or more target keywords.' },
            { n: '02', color: '#A78BFA', title: 'Run a scan', desc: 'CrawlGap collects sitemap URLs and competitor URL data for the project.' },
            { n: '03', color: '#F5A524', title: 'Review keywords', desc: 'Explore keyword phrases and their linked source pages in the project workspace.' },
            { n: '04', color: '#A78BFA', title: 'Plan topics', desc: 'Use the topic planning tools to generate and review a hub and spoke structure.' },
            { n: '05', color: '#F5A524', title: 'Create a draft or prompt', desc: 'Generate an article draft or a page prompt to continue your work.' },
          ].map((step, i) => (
            <div class="step-card reveal" style={`animation-delay:${i * 0.12}s`}>
              <div class="step-number" style={`color:${step.color};border-color:${step.color}22;background:${step.color}11`}>{step.n}</div>
              <div class="step-connector-line" aria-hidden="true"></div>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-desc">{step.desc}</p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ══════════════════════════════════════
         KEYWORD EXAMPLE
    ══════════════════════════════════════ -->
    <section class="section" aria-labelledby="preview-heading">
      <div class="container">
        <div class="section-header reveal">
          <p class="section-label">Example</p>
          <h2 id="preview-heading" class="section-title">
            Review keyword opportunities,<br/><span class="gradient-text">with their source pages</span>
          </h2>
          <p class="section-desc">
            The project table shows keyword phrases with linked source URLs and available keyword data. You can filter, save, and export results.
          </p>
        </div>

        <div class="table-preview-wrapper reveal glass-card" style="border-radius:20px;overflow:hidden;">
          <div class="table-preview-header">
            <div class="table-preview-title">
              <span class="dot dot-green"></span>
              Example project keyword results
            </div>
            <div class="table-actions">
              <button class="btn btn-ghost btn-sm" disabled>Export CSV</button>
            </div>
          </div>
          <div style="overflow-x:auto;">
            <table class="feature-table" aria-label="Sample keyword opportunities table">
              <thead>
                <tr>
                  <th style="text-align:left;width:40%;">Keyword Phrase</th>
                  <th>Keyword type</th>
                  <th>Source pages</th>
                </tr>
              </thead>
              <tbody>
                {['content gap analysis', 'keyword clustering strategy', 'competitor SEO audit'].map(kw => (
                  <tr>
                    <td><span class="kw-phrase">{kw}</span></td>
                    <td><span class="type-badge">Keyword gap</span></td>
                    <td style="text-align:center;color:var(--color-text-muted);">View linked URLs in project</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="table-footer">
            <span>Illustrative sample</span>
            <a href={registerUrl} class="btn btn-primary btn-sm">Open CrawlGap →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         FAQ SECTION
    ══════════════════════════════════════ -->
    <section class="section" aria-labelledby="faq-heading">
      <div class="container">
        <div class="section-header reveal">
          <p class="section-label">FAQ</p>
          <h2 id="faq-heading" class="section-title">
            Frequently asked<br/><span class="gradient-text">questions</span>
          </h2>
        </div>

        <div class="faq-container reveal">
          {[
            {
              q: 'What does a CrawlGap scan do?',
              a: 'A scan collects sitemap and competitor URL data for a project and produces keyword opportunities linked to source pages. Results depend on the URLs and data the scan can access.',
            },
            {
              q: 'Can CrawlGap write or plan content?',
              a: 'CrawlGap includes tools to generate keyword ideas, hub and spoke topic plans, article drafts, and prompts for building pages. Review generated suggestions before using them.',
            },
            {
              q: 'Can I export keyword results?',
              a: 'Yes. Project keywords can be exported as a CSV file.',
            },
            {
              q: 'Does CrawlGap guarantee rankings or traffic?',
              a: 'No. CrawlGap provides research and drafting tools; search rankings and traffic depend on many factors outside the product.',
            },
          ].map((item, i) => (
            <div class="faq-item">
              <button
                class="faq-trigger"
                aria-expanded="false"
                aria-controls={`faq-body-${i}`}
                id={`faq-trigger-${i}`}
              >
                {item.q}
                <span class="faq-icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </span>
              </button>
              <div class="faq-body" id={`faq-body-${i}`} role="region" aria-labelledby={`faq-trigger-${i}`}>
                <div class="faq-body-inner">{item.a}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         CTA BANNER
    ══════════════════════════════════════ -->
    <section class="section cta-section" aria-labelledby="cta-heading">
      <div class="container">
        <div class="cta-card reveal">
          <div class="cta-glow" aria-hidden="true"></div>
          <div class="cta-content">
            <p class="section-label" style="margin-bottom:1rem;">Ready to start?</p>
            <h2 id="cta-heading" class="cta-title">
              Explore your content<br/>opportunities with <span class="gradient-text">CrawlGap</span>
            </h2>
            <p class="cta-desc">
              Create a project to compare sitemap URLs and explore the available research tools.
            </p>
            <div class="cta-actions">
              <a href={registerUrl} class="btn btn-primary btn-lg" id="bottom-cta-primary">
                Get Started — It's Free
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <path d="M3.75 9h10.5M9 3.75 14.25 9 9 14.25" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ── HERO ── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 96px;
    padding-bottom: 4rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero-stats { justify-content: center; }
    .hero-cta { justify-content: center; }
    .hero-visual { order: -1; }
  }

  .hero-title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.1875rem);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 480px;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-stat { display: flex; flex-direction: column; gap: 0.25rem; }
  .hero-stat-value {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }
  .hero-stat-label { font-size: 0.8125rem; color: var(--color-text-muted); }
  .hero-stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border-2);
    flex-shrink: 0;
  }

  /* Dashboard frame */
  .hero-visual { position: relative; }

  .dashboard-frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--color-border-2);
    box-shadow: 0 40px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.04);
    background: var(--color-bg-2);
  }

  .dashboard-chrome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .chrome-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: block;
  }

  .chrome-url {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-faint);
    background: var(--color-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    flex: 1;
    max-width: 280px;
  }

  .dashboard-img { width: 100%; height: auto; display: block; }

  /* Floating pills */
  .floating-pill {
    position: absolute;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    border: 1px solid;
  }

  .pill-1 {
    background: rgba(245,165,36,0.1);
    border-color: rgba(245,165,36,0.3);
    color: var(--color-amber);
    top: -24px;
    right: 60px;
  }

  .pill-2 {
    background: rgba(167,139,250,0.1);
    border-color: rgba(167,139,250,0.3);
    color: var(--color-violet);
    bottom: 40px;
    left: -40px;
  }

  .pill-3 {
    background: rgba(245,165,36,0.08);
    border-color: rgba(245,165,36,0.25);
    color: var(--color-amber);
    bottom: -16px;
    right: 20px;
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .scroll-dot {
    width: 28px;
    height: 48px;
    border: 2px solid var(--color-border-2);
    border-radius: 14px;
    position: relative;
  }

  .scroll-dot::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 8px;
    background: var(--color-amber);
    border-radius: 2px;
    animation: scroll-bounce 1.5s ease-in-out infinite;
  }

  @keyframes scroll-bounce {
    0%, 100% { top: 6px; opacity: 1; }
    70% { top: 26px; opacity: 0; }
  }

  /* ── MARQUEE ── */
  .marquee-section {
    padding-block: 3rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: rgba(255,255,255,0.01);
  }

  .marquee-label {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  .marquee-track {
    display: flex;
    gap: 0;
    width: max-content;
  }

  .marquee-item {
    padding: 0 2.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text-faint);
    opacity: 0.6;
    white-space: nowrap;
    border-right: 1px solid var(--color-border);
    line-height: 1;
    padding-block: 0.25rem;
    transition: opacity 0.2s;
  }

  /* ── SECTION HEADERS ── */
  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 4rem;
  }

  .section-label {
    display: block;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-amber);
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .section-desc {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 580px;
    margin: 0 auto;
  }

  /* ── FEATURES ── */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 960px) { .features-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .features-grid { grid-template-columns: 1fr; } }

  .feature-card { padding: 2rem; }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }
  .feature-icon-amber { background: var(--color-amber-glow); color: var(--color-amber); border: 1px solid rgba(245,165,36,0.22); }
  .feature-icon-violet { background: var(--color-violet-glow); color: var(--color-violet); border: 1px solid rgba(167,139,250,0.22); }
  .feature-icon-green { background: var(--color-green-glow); color: var(--color-green); border: 1px solid rgba(52,211,153,0.22); }

  .feature-title { font-size: 1.0625rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--color-text); }
  .feature-desc { font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.65; }

  /* ── HOW IT WORKS ── */
  .how-section { position: relative; overflow: hidden; }
  .how-bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; }

  .steps-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  @media (max-width: 900px) { .steps-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .steps-grid { grid-template-columns: 1fr; } }

  .step-card {
    position: relative;
    padding: 1.75rem 1.25rem;
