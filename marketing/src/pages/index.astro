---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dashboardUrl } from '../lib/appLinks';

const registerUrl = dashboardUrl('/register');
---

<BaseLayout
  title="CrawlGap — Content intelligence"
  description="We search Google, read the ranking sites' sitemaps, and compare them with yours — then give you the topical map of the gaps, with plug-and-play keywords and prompts to build on them."
>
  <Header />
  <main>
        <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-bg" aria-hidden="true">
        <div class="glow-orb glow-amber" style="width:600px;height:600px;top:-200px;left:-100px;"></div>
        <div class="glow-orb glow-violet" style="width:500px;height:500px;top:100px;right:-150px;"></div>
        <div class="bg-grid" style="position:absolute;inset:0;opacity:0.6;"></div>
      </div>

      <div class="container hero-inner">
        <div class="hero-content">
          <div class="badge badge-amber animate-fade-up" style="margin-bottom:1.5rem;">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><circle cx="6" cy="6" r="6" opacity="0.3"/><circle cx="6" cy="6" r="3"/></svg>
            Now in Public Beta — Free to Start
          </div>

          <h1 id="hero-heading" class="hero-title animate-fade-up delay-100">
            Uncover Your Competitors'<br/>
            <span class="gradient-text">SEO Strategy</span> in Minutes
          </h1>

          <p class="hero-subtitle animate-fade-up delay-200">
            CrawlGap reads your sitemap and competitor sitemaps, compares URL topics,
            and delivers a prioritized list of keyword gaps —
            so you can create content that actually ranks.
          </p>

          <div class="hero-cta animate-fade-up delay-300">
            <a href={registerUrl} class="btn btn-primary btn-lg" id="hero-cta-primary">
              Start Analyzing Free
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M3.75 9h10.5M9 3.75 14.25 9 9 14.25" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="#how-it-works" class="btn btn-ghost btn-lg" id="hero-cta-demo">
              See How It Works
            </a>
          </div>

          <div class="hero-stats animate-fade-up delay-400">
            <div class="hero-stat">
              <span class="hero-stat-value">50K+</span>
              <span class="hero-stat-label">Keywords discovered</span>
            </div>
            <div class="hero-stat-divider" aria-hidden="true"></div>
            <div class="hero-stat">
              <span class="hero-stat-value">2M+</span>
              <span class="hero-stat-label">URLs analyzed</span>
            </div>
            <div class="hero-stat-divider" aria-hidden="true"></div>
            <div class="hero-stat">
              <span class="hero-stat-value">&lt;2hr</span>
              <span class="hero-stat-label">Per 200-page blog</span>
            </div>
          </div>
        </div>

        <!-- Dashboard Mockup -->
        <div class="hero-visual animate-fade-up delay-200">
          <div class="dashboard-frame">
            <div class="dashboard-chrome" aria-hidden="true">
              <span class="chrome-dot" style="background:#ff5f57;"></span>
              <span class="chrome-dot" style="background:#febc2e;"></span>
              <span class="chrome-dot" style="background:#28c840;"></span>
              <span class="chrome-url">app.crawlgap.io/projects</span>
            </div>
            <img
              src="/dashboard-mockup.png"
              alt="CrawlGap dashboard showing keyword opportunities table with competitor SEO analysis"
              width="680"
              height="420"
              loading="eager"
              fetchpriority="high"
              class="dashboard-img"
            />
          </div>
          <!-- Floating keyword pills -->
          <div class="floating-pill pill-1 animate-float" aria-hidden="true">content gap analysis</div>
          <div class="floating-pill pill-2 animate-float delay-200" aria-hidden="true">LSI keywords</div>
          <div class="floating-pill pill-3 animate-float delay-400" aria-hidden="true">competitor SEO</div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="scroll-indicator" aria-hidden="true">
        <div class="scroll-dot"></div>
      </div>
    </section>

    <section class="marquee-section" aria-label="Used by SEO professionals at">
      <div class="container">
        <p class="marquee-label">Trusted by SEO professionals at</p>
      </div>
      <div class="marquee-wrapper">
        <div class="marquee-track animate-marquee" aria-hidden="true">
          {['Shopify', 'HubSpot', 'Moz', 'Ahrefs', 'Semrush', 'Surfer SEO', 'Clearscope', 'ContentKing', 'Shopify', 'HubSpot', 'Moz', 'Ahrefs', 'Semrush', 'Surfer SEO', 'Clearscope', 'ContentKing'].map(name => (
            <span class="marquee-item">{name}</span>
          ))}
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════
         HOW IT WORKS
    ══════════════════════════════════════ -->
    <section id="how-it-works" class="section" aria-labelledby="how-heading">
      <div class="container">
        <div class="section-header reveal">
          <p class="section-label">How it works</p>
          <h2 id="how-heading" class="section-title">Four steps. No black box.</h2>
        </div>

        <div class="steps-grid">
          <article class="step-card reveal">
            <span class="step-number">01</span>
            <h3 class="step-title">Search</h3>
            <p class="step-desc">Enter your site and your topic. CrawlGap searches Google and finds the sites ranking for it.</p>
          </article>
          <article class="step-card reveal">
            <span class="step-number">02</span>
            <h3 class="step-title">Read sitemaps</h3>
            <p class="step-desc">CrawlGap reads the sitemaps of the ranking sites — the lists of pages sites publish — mechanically, and compares them to find the gaps.</p>
          </article>
          <article class="step-card reveal">
            <span class="step-number">03</span>
            <h3 class="step-title">Compare</h3>
            <p class="step-desc">Your sitemap is compared with theirs. A gap is a topic they cover that your site does not cover yet.</p>
          </article>
          <article class="step-card reveal">
            <span class="step-number">04</span>
            <h3 class="step-title">Map</h3>
            <p class="step-desc">You get a topical map around your home page topic, with the keywords and prompts in build order.</p>
          </article>
        </div>

        <p class="honesty-line reveal">
          CrawlGap reads sitemaps — the lists of pages sites publish — mechanically, and compares
          them to find the gaps. <strong>It does not read or copy a competitor's text.</strong>
        </p>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         PLAYGROUND — SITEMAP GAP PREVIEW
    ══════════════════════════════════════ -->
    <section id="playground" class="section pg-section" aria-labelledby="playground-heading">
      <div class="container">
        <div class="section-header reveal">
          <p class="section-label">Interactive preview</p>
          <h2 id="playground-heading" class="section-title">Feel how a scan works.</h2>
          <p class="section-desc">
            Pick a sample competitor and watch a simulated run — sitemaps read,
            topics compared, gaps found. This is a drawn sample, not a real run.
          </p>
        </div>

        <div class="pg-shell reveal" id="pg-shell">
          <div class="pg-chrome" aria-hidden="true">
            <div class="pg-chrome-dots"><span></span><span></span><span></span></div>
            <div class="pg-chrome-url">crawlgap.app/preview — interactive demo</div>
          </div>
          <div class="pg-head">
            <div>
              <p class="pg-eyebrow">Sitemap Gap Preview</p>
              <p class="pg-title">Compare sitemap topics before any page scraping starts.</p>
            </div>
            <span class="pg-sample-badge">Sample preview — not a real run</span>
          </div>

          <div class="pg-tabs" role="tablist" aria-label="Sample competitors">
            <button class="pg-tab pg-tab-active" role="tab" aria-selected="true" data-competitor="a">
              sample-rival-a.example.com
            </button>
            <button class="pg-tab" role="tab" aria-selected="false" data-competitor="b">
              sample-rival-b.example.com
            </button>
            <button class="pg-tab" role="tab" aria-selected="false" data-competitor="c">
              sample-rival-c.example.com
            </button>
          </div>

          <p class="pg-status" id="pg-status" aria-live="polite">
            <span class="pg-status-dot"></span><span id="pg-status-text">Pick a competitor above to run the sample scan.</span>
          </p>

          <div class="pg-grid">
            <!-- YOUR SITEMAP -->
            <div class="pg-pane">
              <div class="pg-pane-head">
                <span>Your sitemap</span>
                <span class="pg-count"><span id="pg-your-count">0</span> URLs</span>
              </div>
              <p class="pg-domain">yoursite.example.com</p>
              <ul class="pg-rows" id="pg-your-rows" aria-label="Your sitemap pages"></ul>
            </div>

            <!-- DONUT -->
            <div class="pg-donut-wrap">
              <svg class="pg-donut" viewBox="0 0 140 140" role="img" aria-label="Topic overlap">
                <circle cx="70" cy="70" r="54" class="pg-donut-track" />
                <circle cx="70" cy="70" r="54" class="pg-donut-fill" id="pg-donut-fill" />
                <text x="70" y="66" text-anchor="middle" class="pg-donut-pct" id="pg-donut-pct">0%</text>
                <text x="70" y="88" text-anchor="middle" class="pg-donut-label">topic overlap</text>
              </svg>
              <div class="pg-meter"><span id="pg-meter-fill"></span></div>
              <p class="pg-hint">Different competitor sitemap,<br />different gap list.</p>
            </div>

            <!-- COMPETITOR SITEMAP -->
            <div class="pg-pane">
              <div class="pg-pane-head">
                <span id="pg-comp-title">sample-rival-a.example.com sitemap</span>
                <span class="pg-count"><span id="pg-comp-count">0</span> URLs</span>
              </div>
              <p class="pg-domain" id="pg-comp-domain">sample-rival-a.example.com</p>
              <ul class="pg-rows" id="pg-comp-rows" aria-label="Competitor sitemap pages"></ul>
            </div>
          </div>

          <!-- GAPS -->
          <div class="pg-gaps" id="pg-gaps" hidden>
            <div class="pg-gaps-head">
              <div>
                <p class="pg-pane-head" style="margin-bottom:0.25rem;">Keyword gaps found</p>
                <p class="pg-gaps-title"><span id="pg-gap-n">0</span> opportunities</p>
              </div>
              <span class="pg-sample-badge">3 sitemap sources</span>
            </div>
            <div class="pg-chips" id="pg-chips"></div>
            <p class="pg-sources" id="pg-sources"></p>
          </div>

          <div class="pg-foot">
            <a href={registerUrl} class="btn btn-primary">Run a real scan on your site</a>
            <button class="btn btn-ghost" id="pg-rerun" type="button">Re-run sample</button>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         7 TOOLS — ONE WORKFLOW
    ══════════════════════════════════════ -->
    <section id="tools" class="section" aria-labelledby="tools-heading">
      <div class="container">
        <div class="section-header reveal">
          <p class="section-label">The product</p>
          <h2 id="tools-heading" class="section-title">7 tools. One complete workflow.</h2>
          <p class="section-desc">Each tool feeds the next. One run carries you from a blank site to a build order.</p>
        </div>

        <div class="tools-grid">
          <article class="tool-card reveal">
            <span class="tool-num">01</span>
            <h3 class="tool-title">Seed Finder</h3>
            <p class="tool-kicker">Page Seed Extraction</p>
            <p class="tool-desc">Give it a URL and it pulls the seed keywords — the starting topics everything else grows from.</p>
          </article>
          <article class="tool-card reveal">
            <span class="tool-num">02</span>
            <h3 class="tool-title">Gap Scan</h3>
            <p class="tool-kicker">Keyword gaps vs competitors</p>
            <p class="tool-desc">Your sitemap against the ranking sites'. Every gap is a topic they cover that you don't — yet.</p>
          </article>
          <article class="tool-card reveal">
            <span class="tool-num">03</span>
            <h3 class="tool-title">Hub &amp; Spoke Architecture</h3>
            <p class="tool-kicker">Topic groups in build order</p>
            <p class="tool-desc">Gaps organized into topic groups around your home page topic — sequenced so you build in the right order.</p>
          </article>
          <article class="tool-card reveal">
            <span class="tool-num">04</span>
            <h3 class="tool-title">Astro Launchpad</h3>
            <p class="tool-kicker">Master Blueprint</p>
            <p class="tool-desc">The whole-site prompt that produces your Master Blueprint: what to build, in what order, topic by topic.</p>
          </article>
          <article class="tool-card reveal">
            <span class="tool-num">05</span>
            <h3 class="tool-title">Build Page</h3>
            <p class="tool-kicker">Tool &amp; gap page prompts</p>
            <p class="tool-desc">Give it a keyword and it studies the pages that rank for it. You check the intent, you get a build prompt for a tool or gap page.</p>
          </article>
          <article class="tool-card reveal">
            <span class="tool-num">06</span>
            <h3 class="tool-title">Blog Writer</h3>
            <p class="tool-kicker">Draft + audit</p>
            <p class="tool-desc">Pick a keyword gap and the writer drafts the article. The auditor scores it, and you get the finished draft to check before you publish.</p>
          </article>
          <article class="tool-card reveal">
            <span class="tool-num">07</span>
            <h3 class="tool-title">Keyword Bank</h3>
            <p class="tool-kicker">Saved Keywords Queue</p>
            <p class="tool-desc">Every gap queued with its priority and status — your build list, always in order, never lost.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         WHAT YOU GET FROM ONE RUN
    ══════════════════════════════════════ -->
    <section class="section outputs-section" aria-labelledby="outputs-heading">
      <div class="container">
        <div class="section-header reveal">
          <p class="section-label">One run</p>
          <h2 id="outputs-heading" class="section-title">What you get from one run</h2>
        </div>

        <ul class="outputs-list reveal">
          <li><span class="outputs-check">✓</span> Seed List</li>
          <li><span class="outputs-check">✓</span> Gap Report</li>
          <li><span class="outputs-check">✓</span> Topical Map</li>
          <li><span class="outputs-check">✓</span> Master Blueprint</li>
          <li><span class="outputs-check">✓</span> Tool Page Brief and Tool Page Prompt</li>
          <li><span class="outputs-check">✓</span> Article Brief and Article Prompt</li>
          <li><span class="outputs-check">✓</span> Keyword Bank</li>
        </ul>

        <p class="outputs-closer reveal">
          Every keyword comes with its prompt. Every gap comes with its place in the plan.
          Nothing to work out by hand.
        </p>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         BUILT FOR EMD BUILDERS
    ══════════════════════════════════════ -->
    <section class="section emd-section" aria-labelledby="emd-heading">
      <div class="container">
        <div class="emd-card reveal">
          <p class="section-label">Who it's for</p>
          <h2 id="emd-heading" class="section-title">Built for EMD builders.</h2>
          <p class="emd-body">
            Get the keywords and prompts to build an AI-generated site, topic by topic.
            It works for a new or thin site — a long gap list is your build list, not a fault.
            Agencies and clients use the same reports to plan content for the sites they run.
          </p>
          <p class="emd-method">One run. One map. One build order. That is the method.</p>
          <a href={registerUrl} class="btn btn-primary btn-lg">Start Analyzing Free</a>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         HONEST ANSWERS — FAQ
    ══════════════════════════════════════ -->
    <section id="faq" class="section" aria-labelledby="faq-heading">
      <div class="container faq-container">
        <div class="section-header reveal">
          <p class="section-label">FAQ</p>
          <h2 id="faq-heading" class="section-title">Honest answers.</h2>
        </div>

        <div class="faq-list">
          <details class="faq-item reveal">
            <summary>Why not just use Semrush?</summary>
            <p>Semrush works from a keyword database. CrawlGap works from a sitemap comparison — it reads the sitemaps of the sites that rank and compares them with yours. Different method, different output. It is not a Semrush replacement, and it does not claim the same data or coverage.</p>
          </details>
          <details class="faq-item reveal">
            <summary>Is this copying competitors?</summary>
            <p>No. CrawlGap compares the topics listed in sitemaps. It does not read or copy a competitor's text. Every prompt is built from the gap — the topic your site does not cover yet — not from a competitor's wording. You check every generated page before you publish it.</p>
          </details>
          <details class="faq-item reveal">
            <summary>How fresh is the data?</summary>
            <p>Every map and report is a dated snapshot. Google results change, so gaps can change. Re-run for a new snapshot.</p>
          </details>
          <details class="faq-item reveal">
            <summary>What if my site is new or small?</summary>
            <p>CrawlGap is built for EMD builders with new and thin sites. A long list of gaps is the build list, not a fault — and not a promise of a ranking.</p>
          </details>
        </div>

        <div class="gap-defs reveal">
          <h3 class="gap-defs-title">What counts as a gap</h3>
          <p class="gap-defs-intro">
            A gap is a topic shown in the sitemaps of the sites ranking for your topic on the date
            of the run, that does not appear in your site's sitemap — or an existing article in your
            sitemap whose topic the ranking sites cover with additional keywords and subtopics yours does not list.
          </p>
          <dl class="gap-defs-grid">
            <div class="gap-def">
              <dt>Missing topic</dt>
              <dd>No page for the topic in your sitemap.</dd>
            </div>
            <div class="gap-def">
              <dt>Missing subtopic</dt>
              <dd>The main topic is covered, but a subtopic in the ranking sitemaps is not in yours.</dd>
            </div>
            <div class="gap-def">
              <dt>Thin coverage</dt>
              <dd>You cover the topic, but the ranking sitemaps list more pages under it by count.</dd>
            </div>
            <div class="gap-def">
              <dt>Improve article</dt>
              <dd>A page you already have, flagged from the sitemap comparison, with a prompt and additional keyword targeting for more coverage. Coverage only — never a judgement on the writing.</dd>
            </div>
          </dl>
          <p class="disclaimer">
            CrawlGap shows a snapshot from the crawl date. Google results change, so gaps can change.
            A gap is a topic your site does not cover yet — <strong>not a promise of a ranking, traffic, or income.</strong>
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         FINAL CTA
    ══════════════════════════════════════ -->
    <section class="section cta-section" aria-labelledby="cta-heading">
      <div class="container">
        <div class="cta-card reveal">
          <div class="glow-orb glow-amber" style="width:480px;height:480px;top:-160px;left:50%;transform:translateX(-50%);opacity:0.5;" aria-hidden="true"></div>
          <h2 id="cta-heading" class="cta-title">See the gaps in your own sitemap.</h2>
          <p class="cta-desc">One run. One map. One build order. Start with your site, free.</p>
          <a href={registerUrl} class="btn btn-primary btn-lg">Start Analyzing Free</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* ── HERO (restored original) ── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 96px;
    padding-bottom: 4rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero-stats { justify-content: center; }
    .hero-cta { justify-content: center; }
    .hero-visual { order: -1; }
  }

  .hero-title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.1875rem);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 480px;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-stat { display: flex; flex-direction: column; gap: 0.25rem; }
  .hero-stat-value {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }
  .hero-stat-label { font-size: 0.8125rem; color: var(--color-text-muted); }
  .hero-stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border-2);
    flex-shrink: 0;
  }

  /* Dashboard frame */
  .hero-visual { position: relative; }

  .dashboard-frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--color-border-2);
    box-shadow: 0 40px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.04);
    background: var(--color-bg-2);
  }

  .dashboard-chrome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .chrome-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: block;
  }

  .chrome-url {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-faint);
    background: var(--color-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    flex: 1;
    max-width: 280px;
  }

  .dashboard-img { width: 100%; height: auto; display: block; }

  /* Floating pills */
  .floating-pill {
    position: absolute;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    border: 1px solid;
  }

  .pill-1 {
    background: rgba(245,165,36,0.1);
    border-color: rgba(245,165,36,0.3);
    color: var(--color-amber);
    top: -24px;
    right: 60px;
  }

  .pill-2 {
    background: rgba(167,139,250,0.1);
    border-color: rgba(167,139,250,0.3);
    color: var(--color-violet);
    bottom: 40px;
    left: -40px;
  }

  .pill-3 {
    background: rgba(245,165,36,0.08);
    border-color: rgba(245,165,36,0.25);
    color: var(--color-amber);
    bottom: -16px;
    right: 20px;
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .scroll-dot {
    width: 28px;
    height: 48px;
    border: 2px solid var(--color-border-2);
    border-radius: 14px;
    position: relative;
  }

  .scroll-dot::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 8px;
    background: var(--color-amber);
    border-radius: 2px;
    animation: scroll-bounce 1.5s ease-in-out infinite;
  }

  @keyframes scroll-bounce {
    0%, 100% { top: 6px; opacity: 1; }
    70% { top: 26px; opacity: 0; }
  }

  /* ── MARQUEE ── */
  .marquee-section {
    padding-block: 3rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: rgba(255,255,255,0.01);
  }

  .marquee-label {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  .marquee-track {
    display: flex;
    gap: 0;
    width: max-content;
  }

  .marquee-item {
    padding: 0 2.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text-faint);
    opacity: 0.6;
    white-space: nowrap;
    border-right: 1px solid var(--color-border);
    line-height: 1;
    padding-block: 0.25rem;
    transition: opacity 0.2s;
  }

  /* ── SECTION HEADERS ── */
  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 4rem;
  }

  .section-label {
    display: block;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-amber);
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .section-desc {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 580px;
    margin: 0 auto;
  }

  
  /* ── HERO ── */
  .hero { position: relative; overflow: hidden; padding: 7rem 0 5rem; }
  .hero-bg { position: absolute; inset: 0; pointer-events: none; }
  .hero-inner { position: relative; z-index: 1; }
  .hero-content { max-width: 820px; }
  .hero-eyebrow {
    font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-amber);
    margin: 0 0 1.25rem;
  }
  .hero-title {
    font-family: var(--font-heading); font-weight: 800;
    font-size: clamp(2.75rem, 6vw, 4.5rem); line-height: 1.05;
    letter-spacing: -0.03em; margin: 0 0 1.5rem; color: var(--color-text);
  }
  .hero-subtitle {
    font-size: clamp(1.0625rem, 2vw, 1.25rem); line-height: 1.65;
    color: var(--color-text-muted); max-width: 640px; margin: 0 0 2.25rem;
  }
  .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 3rem; }
  .hero-stats { display: flex; gap: 3rem; flex-wrap: wrap; }
  .hero-stat { display: flex; flex-direction: column; gap: 0.25rem; }
  .hero-stat-value {
    font-family: var(--font-heading); font-size: 2rem; font-weight: 800;
    color: var(--color-text); letter-spacing: -0.02em;
  }
  .hero-stat-label { font-size: 0.875rem; color: var(--color-text-muted); }

  /* ── SECTIONS ── */
  .section { padding: clamp(4rem, 8vw, 7rem) 0; position: relative; }
  .section-header { max-width: 720px; margin-bottom: 3rem; }
  .section-label {
    font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-amber);
    margin: 0 0 1rem;
  }
  .section-title {
    font-family: var(--font-heading); font-weight: 800;
    font-size: clamp(1.875rem, 4vw, 2.75rem); letter-spacing: -0.02em;
    line-height: 1.15; margin: 0 0 1rem; color: var(--color-text);
  }
  .section-desc { font-size: 1.0625rem; line-height: 1.65; color: var(--color-text-muted); margin: 0; }

  /* ── HOW IT WORKS ── */
  .steps-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem;
    margin-bottom: 2.5rem;
  }
  @media (max-width: 900px) { .steps-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .steps-grid { grid-template-columns: 1fr; } }
  .step-card {
    background: linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.015)), var(--color-surface);
    border: 1px solid var(--color-border); border-radius: 18px; padding: 1.75rem 1.5rem;
    transition: transform 0.3s var(--ease-smooth), border-color 0.3s;
  }
  .step-card:hover { transform: translateY(-4px); border-color: var(--color-border-2); }
  .step-number {
    font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 700;
    color: var(--color-amber); letter-spacing: 0.1em;
    display: inline-block; margin-bottom: 1rem;
    padding: 0.375rem 0.75rem; border-radius: 8px;
    background: var(--color-amber-glow); border: 1px solid rgba(245,165,36,0.25);
  }
  .step-title { font-family: var(--font-heading); font-size: 1.125rem; font-weight: 700; margin: 0 0 0.625rem; color: var(--color-text); }
  .step-desc { font-size: 0.9375rem; line-height: 1.65; color: var(--color-text-muted); margin: 0; }
  .honesty-line {
    max-width: 760px; font-size: 1rem; line-height: 1.7; color: var(--color-text-muted);
    border-left: 3px solid var(--color-amber); padding-left: 1.25rem; margin: 0;
  }
  .honesty-line strong { color: var(--color-text); }

  /* ── PLAYGROUND ── */
  .pg-section { background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(245,165,36,0.05), transparent 70%); }
  .pg-shell {
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.012)), var(--color-surface);
    border: 1px solid var(--color-border); border-radius: 18px;
    max-width: 860px; margin: 0 auto;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    box-shadow: 0 32px 90px rgba(0,0,0,0.35), 0 0 0 1px rgba(245,165,36,0.04), 0 0 80px rgba(245,165,36,0.05);
    position: relative; overflow: hidden;
    font-size: 0.875rem;
  }
  .pg-chrome {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0 0 1rem; margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .pg-chrome-dots { display: flex; gap: 0.375rem; }
  .pg-chrome-dots span { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.14); }
  .pg-chrome-dots span:first-child { background: rgba(245,165,36,0.7); }
  .pg-chrome-url {
    font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-text-muted);
    background: rgba(0,0,0,0.3); border: 1px solid var(--color-border); border-radius: 8px;
    padding: 0.3125rem 0.75rem; flex: 1; text-align: center; white-space: nowrap; overflow: hidden;
  }
  .pg-shell .pg-title { font-size: clamp(1.0625rem, 2vw, 1.25rem); }
  .pg-shell .pg-grid { grid-template-columns: 1fr 180px 1fr; gap: 1rem; margin-bottom: 1.25rem; }
  .pg-shell .pg-pane { min-height: 0; padding: 1rem; }
  .pg-shell .pg-row { font-size: 0.75rem; }
  .pg-shell .pg-chip { font-size: 0.75rem; padding: 0.375rem 0.625rem; }
  .pg-section .section-header { max-width: 640px; margin-bottom: 2rem; }
  .pg-section .section-title { font-size: clamp(1.5rem, 3vw, 2rem); }
  .pg-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .pg-eyebrow {
    font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-amber); margin: 0 0 0.5rem;
  }
  .pg-title { font-family: var(--font-heading); font-size: clamp(1.25rem, 2.5vw, 1.625rem); font-weight: 700; color: var(--color-text); margin: 0; letter-spacing: -0.01em; }
  .pg-sample-badge {
    font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600;
    color: var(--color-amber); background: var(--color-amber-glow);
    border: 1px solid rgba(245,165,36,0.28); border-radius: 999px;
    padding: 0.4375rem 0.875rem; white-space: nowrap;
  }
  .pg-tabs { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .pg-tab {
    font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 600;
    color: var(--color-text-muted); background: rgba(255,255,255,0.03);
    border: 1px solid var(--color-border); border-radius: 10px;
    padding: 0.625rem 1rem; cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .pg-tab:hover { color: var(--color-text); border-color: var(--color-border-2); }
  .pg-tab-active, .pg-tab[aria-selected="true"] {
    color: var(--color-amber); border-color: rgba(245,165,36,0.45);
    background: var(--color-amber-glow);
    box-shadow: 0 0 24px rgba(245,165,36,0.12);
  }
  .pg-status {
    display: flex; align-items: center; gap: 0.625rem;
    font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-text-muted);
    margin: 0 0 1.5rem; min-height: 1.5rem;
  }
  .pg-status-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--color-text-faint);
    flex-shrink: 0; transition: background 0.3s;
  }
  .pg-status.running .pg-status-dot { background: var(--color-amber); animation: pg-pulse 1.2s ease-in-out infinite; }
  .pg-status.done .pg-status-dot { background: var(--color-green); animation: none; }
  @keyframes pg-pulse { 0%,100% { opacity: 1; box-shadow: 0 0 0 0 rgba(245,165,36,0.4); } 50% { opacity: 0.6; box-shadow: 0 0 0 6px rgba(245,165,36,0); } }

  .pg-grid { display: grid; grid-template-columns: 1fr 220px 1fr; gap: 1.25rem; align-items: stretch; margin-bottom: 1.5rem; }
  @media (max-width: 900px) { .pg-grid { grid-template-columns: 1fr; } .pg-donut-wrap { order: -1; max-width: 260px; margin: 0 auto; width: 100%; } }
  .pg-pane {
    background: rgba(0,0,0,0.25); border: 1px solid var(--color-border);
    border-radius: 16px; padding: 1.25rem; min-height: 300px;
  }
  .pg-pane-head {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.25rem;
  }
  .pg-count { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-amber); font-weight: 700; white-space: nowrap; }
  .pg-domain { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-text-faint); margin: 0 0 1rem; word-break: break-all; }
  .pg-rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.625rem; }
  :global(.pg-row) {
    border: 1px solid var(--color-border); border-radius: 10px;
    background: rgba(255,255,255,0.025); padding: 0.625rem 0.875rem;
    opacity: 0; transform: translateY(8px);
    transition: opacity 0.4s var(--ease-smooth), transform 0.4s var(--ease-smooth);
  }
  :global(.pg-row.in) { opacity: 1; transform: none; }
  :global(.pg-row-path) { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-text); display: block; word-break: break-all; }
  :global(.pg-row-topic) { font-size: 0.75rem; color: var(--color-text-muted); }

  .pg-donut-wrap {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 1rem; border: 1px dashed var(--color-border-2); border-radius: 16px; padding: 1.25rem;
    background: rgba(255,255,255,0.015);
  }
  .pg-donut { width: 150px; height: 150px; }
  .pg-donut-track { fill: none; stroke: rgba(255,255,255,0.08); stroke-width: 12; }
  .pg-donut-fill {
    fill: none; stroke: var(--color-amber); stroke-width: 12;
    stroke-linecap: round; transform: rotate(-90deg); transform-origin: center;
    stroke-dasharray: 339.29; stroke-dashoffset: 339.29;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pg-donut-pct { font-family: var(--font-heading); font-size: 26px; font-weight: 800; fill: var(--color-text); }
  .pg-donut-label { font-family: var(--font-mono); font-size: 9px; fill: var(--color-text-muted); letter-spacing: 0.08em; }
  .pg-meter { width: 100%; max-width: 180px; height: 6px; border-radius: 999px; background: rgba(255,255,255,0.08); overflow: hidden; }
  .pg-meter span { display: block; height: 100%; width: 0; border-radius: inherit; background: linear-gradient(90deg, var(--color-amber), var(--color-amber-deep)); transition: width 1.4s cubic-bezier(0.22, 1, 0.36, 1); }
  .pg-hint { font-size: 0.8125rem; color: var(--color-text-faint); text-align: center; margin: 0; line-height: 1.6; }

  .pg-gaps {
    border-top: 1px solid var(--color-border); padding-top: 1.5rem; margin-bottom: 1.5rem;
  }
  .pg-gaps[hidden] { display: none; }
  .pg-gaps-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .pg-gaps-title { font-family: var(--font-heading); font-size: 1.375rem; font-weight: 800; color: var(--color-text); margin: 0; letter-spacing: -0.01em; }
  .pg-chips { display: flex; flex-wrap: wrap; gap: 0.625rem; margin-bottom: 1.25rem; }
  :global(.pg-chip) {
    display: inline-flex; align-items: center; gap: 0.5rem;
    border: 1px solid rgba(245,165,36,0.3); background: rgba(245,165,36,0.08);
    border-radius: 999px; padding: 0.5rem 0.875rem;
    font-size: 0.875rem; font-weight: 600; color: var(--color-text);
    opacity: 0; transform: translateY(10px) scale(0.96);
    transition: opacity 0.45s var(--ease-smooth), transform 0.45s var(--ease-smooth);
  }
  :global(.pg-chip.in) { opacity: 1; transform: none; }
  :global(.pg-chip-type) {
    font-family: var(--font-mono); font-size: 0.625rem; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; padding: 0.2rem 0.5rem; border-radius: 6px; white-space: nowrap;
  }
  :global(.pg-chip-type.missing-topic) { color: var(--color-amber); background: rgba(245,165,36,0.14); }
  :global(.pg-chip-type.missing-subtopic) { color: var(--color-violet); background: var(--color-violet-glow); }
  :global(.pg-chip-type.thin) { color: var(--color-green); background: var(--color-green-glow); }
  :global(.pg-chip-type.improve) { color: var(--color-text); background: rgba(255,255,255,0.08); }
  .pg-sources { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-text-faint); margin: 0; line-height: 1.8; word-break: break-all; }
  .pg-sources strong { color: var(--color-text-muted); font-weight: 600; }

  .pg-foot { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }

  /* ── TOOLS ── */
  .tools-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  @media (max-width: 900px) { .tools-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .tools-grid { grid-template-columns: 1fr; } }
  .tools-grid .tool-card:last-child { grid-column: 2; }
  @media (max-width: 900px) { .tools-grid .tool-card:last-child { grid-column: auto; } }
  .tool-card {
    background: linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.015)), var(--color-surface);
    border: 1px solid var(--color-border); border-radius: 18px; padding: 1.75rem 1.5rem;
    transition: transform 0.3s var(--ease-smooth), border-color 0.3s, box-shadow 0.3s;
    position: relative; overflow: hidden;
  }
  .tool-card:hover { transform: translateY(-4px); border-color: rgba(245,165,36,0.35); box-shadow: 0 16px 40px rgba(0,0,0,0.3), 0 0 40px rgba(245,165,36,0.06); }
  .tool-num { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; color: var(--color-text-faint); letter-spacing: 0.12em; display: block; margin-bottom: 0.875rem; }
  .tool-title { font-family: var(--font-heading); font-size: 1.125rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.25rem; }
  .tool-kicker { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-amber); margin: 0 0 0.75rem; }
  .tool-desc { font-size: 0.9375rem; line-height: 1.65; color: var(--color-text-muted); margin: 0; }

  /* ── OUTPUTS ── */
  .outputs-section { background: radial-gradient(ellipse 70% 55% at 50% 100%, rgba(167,139,250,0.05), transparent 70%); }
  .outputs-list {
    list-style: none; margin: 0 0 2.5rem; padding: 0;
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.875rem; max-width: 860px;
  }
  @media (max-width: 640px) { .outputs-list { grid-template-columns: 1fr; } }
  .outputs-list li {
    display: flex; align-items: center; gap: 0.875rem;
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 14px; padding: 1rem 1.25rem;
    font-family: var(--font-heading); font-weight: 600; font-size: 1rem; color: var(--color-text);
  }
  .outputs-check {
    width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--color-green-glow); color: var(--color-green);
    border: 1px solid rgba(52,211,153,0.3); font-size: 0.875rem; font-weight: 700;
  }
  .outputs-closer {
    max-width: 680px; font-family: var(--font-heading); font-size: clamp(1.125rem, 2.4vw, 1.375rem);
    font-weight: 600; line-height: 1.6; color: var(--color-text); margin: 0;
    border-left: 3px solid var(--color-green); padding-left: 1.25rem;
  }

  /* ── EMD ── */
  .emd-card {
    background: linear-gradient(135deg, rgba(245,165,36,0.07), rgba(245,165,36,0.015) 45%, rgba(255,255,255,0.015)), var(--color-surface);
    border: 1px solid rgba(245,165,36,0.22); border-radius: 24px;
    padding: clamp(2rem, 5vw, 3.5rem); max-width: 900px; margin: 0 auto; text-align: center;
    box-shadow: 0 24px 70px rgba(0,0,0,0.3), 0 0 90px rgba(245,165,36,0.06);
  }
  .emd-card .section-label { margin-bottom: 1rem; }
  .emd-card .section-title { margin-bottom: 1.25rem; }
  .emd-body { font-size: 1.0625rem; line-height: 1.7; color: var(--color-text-muted); max-width: 640px; margin: 0 auto 1.75rem; }
  .emd-method {
    font-family: var(--font-heading); font-size: clamp(1.125rem, 2.4vw, 1.375rem); font-weight: 700;
    color: var(--color-amber); margin: 0 0 2rem; letter-spacing: -0.01em;
  }

  /* ── FAQ ── */
  .faq-container { max-width: 820px; }
  .faq-list { margin-bottom: 3.5rem; }
  .faq-item {
    border: 1px solid var(--color-border); border-radius: 14px; margin-bottom: 0.75rem;
    background: var(--color-surface); overflow: hidden;
    transition: border-color 0.25s;
  }
  .faq-item[open] { border-color: var(--color-border-2); }
  .faq-item summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; padding: 1.25rem 1.5rem;
    font-family: var(--font-heading); font-weight: 700; font-size: 1.0625rem; color: var(--color-text);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: "+"; flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%;
    border: 1px solid var(--color-border-2); display: inline-flex; align-items: center; justify-content: center;
    font-size: 1.125rem; font-weight: 400; color: var(--color-amber);
    transition: transform 0.3s var(--ease-smooth), background 0.2s;
  }
  .faq-item[open] summary::after { transform: rotate(45deg); background: var(--color-amber-glow); }
  .faq-item summary:hover { color: var(--color-amber); }
  .faq-item p { padding: 0 1.5rem 1.5rem; margin: 0; color: var(--color-text-muted); line-height: 1.7; font-size: 0.975rem; }

  .gap-defs {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 20px; padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .gap-defs-title { font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--color-text); margin: 0 0 1rem; }
  .gap-defs-intro { color: var(--color-text-muted); line-height: 1.7; font-size: 0.975rem; margin: 0 0 1.75rem; }
  .gap-defs-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; margin: 0 0 1.75rem; padding: 0; }
  @media (max-width: 640px) { .gap-defs-grid { grid-template-columns: 1fr; } }
  .gap-def { margin: 0; }
  .gap-def dt {
    font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--color-amber); margin-bottom: 0.375rem;
  }
  .gap-def dd { margin: 0; color: var(--color-text-muted); font-size: 0.9375rem; line-height: 1.65; }
  .disclaimer {
    font-size: 0.875rem; line-height: 1.7; color: var(--color-text-faint); margin: 0;
    border-top: 1px solid var(--color-border); padding-top: 1.5rem;
  }
  .disclaimer strong { color: var(--color-text-muted); }

  /* ── FINAL CTA ── */
  .cta-card {
    position: relative; overflow: hidden; text-align: center;
    background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.015)), var(--color-surface);
    border: 1px solid rgba(245,165,36,0.25); border-radius: 28px;
    padding: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    box-shadow: 0 32px 90px rgba(0,0,0,0.35), 0 0 100px rgba(245,165,36,0.07);
  }
  .cta-title {
    font-family: var(--font-heading); font-weight: 800; letter-spacing: -0.02em;
    font-size: clamp(1.875rem, 4.5vw, 3rem); line-height: 1.12; color: var(--color-text);
    margin: 0 0 1rem; position: relative;
  }
  .cta-desc { color: var(--color-text-muted); font-size: 1.125rem; margin: 0 0 2.25rem; position: relative; }
  .cta-card .btn { position: relative; }

  @media (prefers-reduced-motion: reduce) {
    :global(.pg-row), :global(.pg-chip) { opacity: 1 !important; transform: none !important; }
    .pg-donut-fill, .pg-meter span { transition: none !important; }
  }
</style>

<script>
  // ── Scroll reveal (shared) ──
  (function () {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els = document.querySelectorAll('.reveal');
    if (reduce || !('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('revealed'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('revealed'); io.unobserve(e.target); }
        });
      },
      { threshold: 0.12 }
    );
    els.forEach((el) => io.observe(el));
  })();

  // ── Playground: Sitemap Gap Preview ──
  (function () {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const shell = document.getElementById('pg-shell');
    if (!shell) return;

    const DONUT_C = 339.29;

    // Sample data only. example.com domains — never real sites.
    const YOUR_ROWS = [
      { path: '/blog/project-basics/', topic: 'project management basics' },
      { path: '/templates/simple-timeline/', topic: 'simple timeline template' },
      { path: '/guides/team-communication/', topic: 'team communication guide' },
    ];

    const COMPETITORS = {
      a: {
        domain: 'sample-rival-a.example.com',
        urls: 214,
        overlap: 38,
        rows: [
          { path: '/features/gantt-charts/', topic: 'gantt chart software' },
          { path: '/templates/project-plan/', topic: 'project plan template' },
          { path: '/guides/kanban-boards/', topic: 'kanban board guide' },
        ],
        gaps: [
          { kw: 'gantt chart software', type: 'missing-topic', label: 'Missing topic' },
          { kw: 'project plan template', type: 'missing-subtopic', label: 'Missing subtopic' },
          { kw: 'kanban board guide', type: 'thin', label: 'Thin coverage' },
          { kw: 'resource allocation software', type: 'missing-topic', label: 'Missing topic' },
          { kw: 'sprint planning tool', type: 'improve', label: 'Improve article' },
          { kw: 'workload management', type: 'missing-subtopic', label: 'Missing subtopic' },
        ],
      },
      b: {
        domain: 'sample-rival-b.example.com',
        urls: 187,
        overlap: 52,
        rows: [
          { path: '/features/time-tracking/', topic: 'time tracking software' },
          { path: '/reports/burndown-charts/', topic: 'burndown charts' },
          { path: '/integrations/slack/', topic: 'slack integration' },
        ],
        gaps: [
          { kw: 'time tracking software', type: 'missing-topic', label: 'Missing topic' },
          { kw: 'burndown charts', type: 'missing-subtopic', label: 'Missing subtopic' },
          { kw: 'slack integration', type: 'thin', label: 'Thin coverage' },
          { kw: 'capacity planning', type: 'missing-topic', label: 'Missing topic' },
          { kw: 'timesheet templates', type: 'improve', label: 'Improve article' },
          { kw: 'billable hours tracking', type: 'missing-subtopic', label: 'Missing subtopic' },
        ],
      },
      c: {
        domain: 'sample-rival-c.example.com',
        urls: 243,
        overlap: 44,
        rows: [
          { path: '/features/roadmaps/', topic: 'product roadmaps' },
          { path: '/templates/retrospective/', topic: 'sprint retrospective template' },
          { path: '/guides/stakeholder-updates/', topic: 'stakeholder updates' },
        ],
        gaps: [
          { kw: 'product roadmaps', type: 'missing-topic', label: 'Missing topic' },
          { kw: 'sprint retrospective template', type: 'missing-subtopic', label: 'Missing subtopic' },
          { kw: 'stakeholder updates', type: 'thin', label: 'Thin coverage' },
          { kw: 'raci chart template', type: 'improve', label: 'Improve article' },
          { kw: 'portfolio management', type: 'missing-topic', label: 'Missing topic' },
          { kw: 'okr tracking software', type: 'missing-subtopic', label: 'Missing subtopic' },
        ],
      },
    };

    const $ = (id) => document.getElementById(id);
    const status = $('pg-status');
    const statusText = $('pg-status-text');
    const yourCount = $('pg-your-count');
    const compCount = $('pg-comp-count');
    const yourRows = $('pg-your-rows');
    const compRows = $('pg-comp-rows');
    const compTitle = $('pg-comp-title');
    const compDomain = $('pg-comp-domain');
    const donutFill = $('pg-donut-fill');
    const donutPct = $('pg-donut-pct');
    const meterFill = $('pg-meter-fill');
    const gapsBox = $('pg-gaps');
    const gapN = $('pg-gap-n');
    const chipsBox = $('pg-chips');
    const sourcesEl = $('pg-sources');
    const tabs = Array.from(shell.querySelectorAll('.pg-tab'));
    const rerunBtn = $('pg-rerun');

    let timers = [];
    let runId = 0;

    function later(fn, ms) {
      timers.push(window.setTimeout(fn, ms));
    }
    function cancelRun() {
      timers.forEach(clearTimeout);
      timers = [];
      runId++;
    }
    function setStatus(text, mode) {
      statusText.textContent = text;
      status.classList.remove('running', 'done');
      if (mode) status.classList.add(mode);
    }
    function rowEl(row) {
      const li = document.createElement('li');
      li.className = 'pg-row';
      const path = document.createElement('span');
      path.className = 'pg-row-path';
      path.textContent = row.path;
      const topic = document.createElement('span');
      topic.className = 'pg-row-topic';
      topic.textContent = row.topic;
      li.appendChild(path);
      li.appendChild(topic);
      return li;
    }
    function tickCount(el, target, dur, done) {
      if (reduce || dur <= 0) { el.textContent = String(target); if (done) done(); return; }
      const start = performance.now();
      (function frame(now) {
        const t = Math.min(1, (now - start) / dur);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(frame);
        else if (done) done();
      })(start);
    }

    function reset() {
      yourCount.textContent = '0';
      compCount.textContent = '0';
      yourRows.innerHTML = '';
      compRows.innerHTML = '';
      donutFill.style.strokeDashoffset = String(DONUT_C);
      donutPct.textContent = '0%';
      meterFill.style.width = '0%';
      gapsBox.hidden = true;
      chipsBox.innerHTML = '';
    }

    function finishInstant(key) {
      const c = COMPETITORS[key];
      yourCount.textContent = '126';
      compCount.textContent = String(c.urls);
      YOUR_ROWS.forEach((r) => { const el = rowEl(r); el.classList.add('in'); yourRows.appendChild(el); });
      c.rows.forEach((r) => { const el = rowEl(r); el.classList.add('in'); compRows.appendChild(el); });
      donutFill.style.strokeDashoffset = String(DONUT_C * (1 - c.overlap / 100));
      donutPct.textContent = c.overlap + '%';
      meterFill.style.width = c.overlap + '%';
      showGaps(c);
      setStatus('Sample complete — ' + c.gaps.length + ' keyword gaps found.', 'done');
    }

    function showGaps(c) {
      gapN.textContent = String(c.gaps.length);
      chipsBox.innerHTML = '';
      c.gaps.forEach((g) => {
        const chip = document.createElement('span');
        chip.className = 'pg-chip';
        const badge = document.createElement('span');
        badge.className = 'pg-chip-type ' + g.type;
        badge.textContent = g.label;
        chip.appendChild(document.createTextNode(g.kw + ' '));
        chip.appendChild(badge);
        chipsBox.appendChild(chip);
      });
      sourcesEl.innerHTML = '';
      const strong = document.createElement('strong');
      strong.textContent = 'Sources: ';
      sourcesEl.appendChild(strong);
      sourcesEl.appendChild(document.createTextNode(
        'yoursite.example.com/sitemap.xml · ' + c.domain + '/sitemap.xml · Google sample snapshot'
      ));
      gapsBox.hidden = false;
      const chips = Array.from(chipsBox.children);
      if (reduce) {
        chips.forEach((ch) => ch.classList.add('in'));
      } else {
        chips.forEach((ch, i) => later(() => ch.classList.add('in'), i * 90));
      }
    }

    function run(key) {
      cancelRun();
      const myRun = runId;
      const c = COMPETITORS[key];

      tabs.forEach((t) => {
        const active = t.dataset.competitor === key;
        t.classList.toggle('pg-tab-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      compTitle.textContent = c.domain + ' sitemap';
      compDomain.textContent = c.domain;
      reset();

      if (reduce) { finishInstant(key); return; }

      // Stage 1 — reading sitemaps
      setStatus('Reading sitemaps — yoursite.example.com vs ' + c.domain + '…', 'running');
      tickCount(yourCount, 126, 1100);
      tickCount(compCount, c.urls, 1300);
      YOUR_ROWS.forEach((r, i) => later(() => { if (myRun === runId) { const el = rowEl(r); yourRows.appendChild(el); requestAnimationFrame(() => el.classList.add('in')); } }, 250 + i * 220));
      c.rows.forEach((r, i) => later(() => { if (myRun === runId) { const el = rowEl(r); compRows.appendChild(el); requestAnimationFrame(() => el.classList.add('in')); } }, 350 + i * 220));

      // Stage 2 — comparing topics
      later(() => {
        if (myRun !== runId) return;
        setStatus('Comparing topics — finding what they cover that you don\'t…', 'running');
        donutFill.style.strokeDashoffset = String(DONUT_C * (1 - c.overlap / 100));
        meterFill.style.width = c.overlap + '%';
        // count the % text up smoothly
        const start = performance.now();
        (function frame(now) {
          if (myRun !== runId) return;
          const t = Math.min(1, (now - start) / 1400);
          donutPct.textContent = Math.round(c.overlap * (1 - Math.pow(1 - t, 3))) + '%';
          if (t < 1) requestAnimationFrame(frame);
        })(start);
      }, 1500);

      // Stage 3 — gaps
      later(() => {
        if (myRun !== runId) return;
        setStatus('Sample complete — ' + c.gaps.length + ' keyword gaps found.', 'done');
        showGaps(c);
      }, 3100);
    }

    tabs.forEach((t) => t.addEventListener('click', () => run(t.dataset.competitor)));
    rerunBtn.addEventListener('click', () => {
      const active = shell.querySelector('.pg-tab-active');
      run(active ? active.dataset.competitor : 'a');
    });

    // Auto-run the first sample when the playground scrolls into view (once)
    let autoRan = false;
    if ('IntersectionObserver' in window && !reduce) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && !autoRan) {
            autoRan = true;
            run('a');
            io.disconnect();
          }
        });
      }, { threshold: 0.35 });
      io.observe(shell);
    }
  })();
</script>
